CONFIG_NUCULA_BOARD_NUCULAPCB=y

# Crash forensics (ccid-firmware-rs #494 audit adoption — the audit's
# highest-value single item: a money device with zero crash forensics):
# dump panics to the `coredump` partition in partitions.csv (ELF format,
# explicit — the Kconfig choice defaults to NONE). A missing/blank
# coredump partition at boot is non-fatal (espcoredump logs and disables
# itself); retrieval: idf.py coredump-info / espcoredump.py over serial.
# Deployed at the next bench reflash (table change).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
